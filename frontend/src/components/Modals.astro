---
// Action + Spike detail modals (populated by main.js).
---

<div class="modal-overlay" id="action-modal" role="dialog" aria-modal="true" aria-labelledby="action-modal-title" aria-hidden="true">
  <div class="modal">
    <div class="modal-header">
      <h3 id="action-modal-title">Action Details</h3>
      <button class="modal-close" id="modal-close" aria-label="Close dialog">×</button>
    </div>
    <div class="modal-body" id="action-modal-body"></div>
  </div>
</div>

<div class="modal-overlay" id="spike-modal" role="dialog" aria-modal="true" aria-labelledby="spike-modal-title" aria-hidden="true">
  <div class="modal">
    <div class="modal-header">
      <h3 id="spike-modal-title">Spike Details</h3>
      <button class="modal-close" id="spike-modal-close" aria-label="Close dialog">×</button>
    </div>
    <div class="modal-body" id="spike-modal-body"></div>
  </div>
</div>